# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventseat_db
DB_USERNAME=eventseat_user
DB_PASSWORD=change_me_in_prod

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_256bit_base64_encoded_secret
JWT_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@eventseat.com

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@eventseat.com
ADMIN_PASSWORD=Admin@123!

# ── QR / Storage ─────────────────────────────────────────────────────────────
QR_STORAGE_PATH=/tmp/eventseat/qr
